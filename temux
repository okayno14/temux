%%% lists
%%%===================================================================

with_index(L) ->
    {_, L2} =
        lists:foldl(
            fun(X, {Index, Acc}) -> {Index + 1, [{Index, X} | Acc]} end,
            {0, []},
            L
        ),
    lists:reverse(L2).

