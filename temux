#!/usr/bin/env escript

-mode(compile).

-include_lib("eunit/include/eunit.hrl").
-include_lib("kernel/include/logger.hrl").

%%%===================================================================
%%% entry
%%%===================================================================

-spec main(Args :: [string()]) ->
    ok
    | sessions_list_ret()
    | init_sessions_ret().

main(Args) ->
    ok = logger:set_primary_config(level, debug),
    ok = logger:update_handler_config(default, level, debug),
    ok = logger:update_formatter_config(
        default,
        template,
        [
            time, " ",
            level, " ",
            pid,
            " [", "temux", ":", line, "]\: ", msg, "\n"
        ]
    ),
    route(Args).

%%%===================================================================
%%% controller
%%%===================================================================

route(["test"]) ->
    some_test();
    %% Need to wait for whole log output (logger sends async logs)
    % timer:sleep(1000);
route(["help"]) ->
    help();
route(["help", "config"]) ->
    help_config();
route(["help", "configuration"]) ->
    help_config();
route([]) ->
    run();
route([FilePath]) ->
    run(FilePath).

%%%===================================================================
%%% compose
%%%===================================================================

help() ->
    Str =
<<"""Commands:
    <File> - read config from <File> (default: ./tmux_sessions)
    test - run unit tests
    help - output this message.
    help config - output info about configuration.
""">>,
    io:format("~ts", [Str]).

help_config() ->
    Str =
<<"""Script reads configuration file and builds tmux-sessions.
Configuration - file with erlang-terms, separated by \".\". Reading done by file:consult/1.
Example of 1 session:
#{
    type => session,
    name => <<\"test\">>,
    windows =>
        [
            #{
                type => window,
                name => <<\"htop\">>,
                panes => [<<\"htop\">>, <<\"nvim -c ':normal ,ww'\">>]
            }
        ]
}.
""">>,
    io:format("~ts", [Str]).

run() ->
    FilePath =
        unicode:characters_to_list([
            filename:dirname(escript:script_name()), "/", "tmux_sessions"
        ]),
    run(FilePath, tmux_struct()).

run(FilePath) ->
    run(FilePath, tmux_struct()).

-spec run(FilePath :: string(), Tmux :: tmux_struct()) ->
    ok
    | sessions_list_ret()
    | init_sessions_ret().

run(FilePath, Tmux) ->
    pipe(
        [
            fun(X) -> flatmap(X, fun sessions_list/1) end,
            % fun(X) -> flatmap(X, fun validate/1) end,
            fun(X) -> flatmap(X, fun(SessionList) -> init_sessions(SessionList, Tmux) end) end,
            fun process_ret/1
        ],
        right(FilePath)
    ).

% validate(SessionList) ->
%     right(SessionList).

%%--------------------------------------------------------------------
%% Errors returned by init_sessions
process_ret(Ret) when is_list(Ret) ->
    pipe(
        [
            fun filter_errors/1,
            fun process_errors/1
        ],
        Ret
    );
process_ret(Ret) ->
    case is_left(Ret) of
        true ->
            {error, Reason} = extract(Ret),
            io:format(
                "Something happened with config. Reason: ~ts\n",
                [file:format_error(Reason)]
            ),
            Ret;
        false ->
            io:format("ok\n", []),
            ok
    end.

filter_errors(Ret) ->
    lists:filter(
        fun({_SessionName, Either}) -> is_left(Either) end,
        Ret
    ).

process_errors([]) ->
    io:format("ok\n", []);
process_errors(Ret) ->
    lists:foreach(
        fun({SessionName, Either}) ->
            {error, Reason} = extract(Either),
            Str =
                unicode:characters_to_binary([
                    "Session:", " ", SessionName, "\n",
                    "    ", io_lib:format("Reason: ~p", [Reason]), "\n"
                ]),
            io:format(standard_error, "~ts", [Str])
        end,
        Ret
    ).
