tmux_struct_fake() ->
    Self = erlang:self(),
    #{
        has_session => fun(_SessionName) -> {error, "no session"} end,
        new_session => fun(_SessionName) ->
            Self ! new_session,
            {ok, ""}
        end,
        new_window => fun(_SessionName, _WindowName) ->
            Self ! new_window,
            {ok, ""}
        end,
        rename_window => fun(_SessionName, _WindowNameOld, _WindowNameNew) ->
            Self ! rename_window,
            {ok, ""}
        end,
        remove_window => fun(_SessionName, _Window) ->
            Self ! remove_window,
            {ok, ""}
        end,
        renumber_windows => fun(_SessionName) ->
            Self ! renumber_windows,
            {ok, ""}
        end,
        split_window => fun(_SessionName, _WindowName) ->
            Self ! split_window,
            {ok, ""}
        end,
        send_cmd => fun(_SessionName, _WindowName, _CMD, _Index) ->
            Self ! send_cmd,
            {ok, ""}
        end
    }.

flush() ->
    flush([]).

flush(L) ->
    receive
        M -> flush([M | L])
    after 0 -> lists:reverse(L)
    end.

